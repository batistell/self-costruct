# Local secrets. Copy to .env; never commit .env.
GEMINI_API_KEY=

# Agent model (configurable)
GEMINI_MODEL=gemini-3.7-flash

# GitHub source of truth
GITHUB_REPOSITORY=batistell/self-costruct
GITHUB_BRANCH=master
# Optional: if omitted, backend reads the token from `gh auth token`.
# GITHUB_TOKEN=

# Local runtime
PORT=3001
SUPERVISOR_PORT=3002
SUPERVISOR_URL=http://127.0.0.1:3002
